__pycache__/
*.pyc
.venv/
.pytest_cache/
build/
*.egg-info/
.DS_Store

# Bazel convenience symlinks and local state (bazel-orfs is a real
# submodule, not one of these, so it's excluded from the glob)
bazel-*
!bazel-orfs
MODULE.bazel.lock
.bazelrc.user

# Pulled-down cluster build artifacts (GDS/DEF/ODB/etc) -- large
# binaries, regenerable from a Nautilus job, not meant for git.
gds_output/

# cocotb per-test result files written next to the driver when a test
# runs with test_dir pointed at the source tree instead of tmp_path.
*.result.xml
