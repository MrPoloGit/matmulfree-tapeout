        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0109-opensta-check-setup-launch-edge.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0109-opensta-check-setup-launch-edge.patch.' && exit 1)",
