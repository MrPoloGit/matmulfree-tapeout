# sv-lang pulls in rules_pycross, whose toolchain extension fails on
# Python 3.8 (transitively registered via or-tools -> pybind11_abseil).
# bazel-orfs's own MODULE.bazel works around this with
# pycross.configure_environments, but that's root-honored only (bazel-orfs
# itself says downstream roots must repeat it) -- mirrored verbatim here.
single_version_override(
    module_name = "rules_pycross",
    patch_strip = 0,
    patches = ["//patches:rules_pycross_no_warning.patch"],
)

bazel_dep(name = "rules_pycross", version = "0.8.3", dev_dependency = True)

pycross = use_extension("@rules_pycross//pycross/extensions:pycross.bzl", "pycross", dev_dependency = True)
pycross.configure_environments(python_versions = ["3.13"])

# @rules_python needs to be visible from this (root) module: our .bazelrc
# try-imports bazel-orfs's .bazelrc, which sets
# --@rules_python//python/config_settings:bootstrap_impl=script, and a
# command-line flag on a repo-qualified label needs that repo resolvable
# from the main repo's own mapping, not just transitively via bazel-orfs.
# 2.3.2 matches bazel-orfs's own root bazel_dep pin (its MODULE.bazel notes
# MVS resolves there regardless given the rest of the graph).
bazel_dep(name = "rules_python", version = "2.3.2")

orfs = use_extension("@bazel-orfs//:extension.bzl", "orfs_repositories")
orfs.source(
    commit = "6b305a712966be72d8908695c04398acdbe273ca",
    integrity = "sha256-mcUpbDm0r8+u3zwyPdBPxEbfRiFulCn0kMDSVPqkL5o=",
)
orfs.default()
use_repo(orfs, "orfs")
